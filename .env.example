# Required: Supabase (use the values from your own project)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace_with_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_supabase_anon_key

# Required: Authentication and administrators
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_a_long_random_secret
ADMIN_EMAILS=admin@example.com

# Optional: Google Calendar
GOOGLE_CALENDAR_ID_1=
GOOGLE_CALENDAR_ID_2=
# Paste the service-account JSON on one line; keep the real key in .env.local only.
GOOGLE_SERVICE_ACCOUNT_KEY=

# Optional: Email
RESEND_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_APP_PASSWORD2=

# Optional: Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Required when enabling scheduled jobs on Vercel
CRON_SECRET=replace_with_a_separate_random_secret
